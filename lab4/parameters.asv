dir = 'C:\Users\Professional\Here i live\Uni\LSAC\lab4\Paper\images';

ke = 0.3222; km = 0.3222;
J = 0.0028; R = 4.6013; L = 1.1319;

%K  = 379e-6;
k = 140;
M = 27;
Tm = (J*R)/(km*ke);
Te = L/R;
K = 1/k;
T = sqrt(M/k);
%T  = sqrt(Tm*Te);
xi = T/(2*Te);

sig_xi  = xi/T;
omega_d = sqrt(1 - xi^2)/T;

mdl = 'model';
load_system(mdl);

io(1) = linio([mdl '/Sine Wave'],    1, 'input');
io(2) = linio([mdl '/Transfer Fcn1'], 1, 'output');
%io(2) = linio([mdl '/Derivative'], 1, 'output');

sys_lin = linearize(mdl, io);

f = logspace(-4, 4, 500);
w = 2*pi*f; 


[mag_s, ph_s] = bode(sys_lin, w);
mag_s = squeeze(mag_s);
ph_s  = squeeze(ph_s);

W = K ./ (1 - T^2*w.^2);
mag_a = abs(W);
ph_a  = angle(W)*180/pi;

wrap = @(p) mod(p + 180, 360) - 180;
ph_a = wrap(ph_a);
ph_s = wrap(ph_s);

disp([K T xi])
disp([mag_a(1) mag_s(1)])
disp(mag_s(1)/mag_a(1))

L_s = 20*log10(mag_s);
L_a = 20*log10(mag_a);

idx = 1:20:numel(w);

fig = figure('Name','АЧХ');
plot(w, mag_a, '-', 'LineWidth', 2.2); hold on
plot(w, mag_s, '--', 'LineWidth', 2.2);
grid on; xlim([0 20])
xlabel('\omega'); ylabel('A(\omega)')
title('АЧХ'); legend('аналитика','Simulink')
exportgraphics(fig, fullfile(dir, 'ACH4.png'), 'Resolution', 300);

fig = figure('Name','ФЧХ');
plot(w, ph_a, '-', 'LineWidth', 2.2);hold on
plot(w, ph_s, '--', 'LineWidth', 2.2);
grid on; xlim([0 20]); ylim([0 100])
xlabel('\omega'); ylabel( '\phi(\omega)');
title('ФЧХ'); legend('аналитика','Simulink')
exportgraphics(fig, fullfile(dir, 'FCH4.png'), 'Resolution', 300);

fig = figure('Name','ЛАЧХ');
semilogx(w, L_a, '-', 'LineWidth', 2.2); hold on
semilogx(w, L_s, '--', 'LineWidth', 2.2);
grid on;
xlabel('\omega'); ylabel('L(\omega), дБ')

title('ЛАЧХ'); legend('аналитика','Simulink')
exportgraphics(fig, fullfile(dir, 'LACH4.png'), 'Resolution', 300);

fig = figure('Name','ЛФЧХ');
semilogx(w, ph_a, '-', 'LineWidth', 2.2); hold on
semilogx(w, ph_s, '--', 'LineWidth', 2.2); 
grid on;
xlabel('\omega'); ylabel('\phi(\omega)')
title('ЛФЧХ'); legend('аналитика','Simulink')
exportgraphics(fig, fullfile(dir, 'LFCH4.png'), 'Resolution', 300);